# 카카오맵 JavaScript 키 (developers.kakao.com > 내 애플리케이션 > JavaScript 키)
# 플랫폼 > Web 사이트 도메인에 http://localhost:5173 과
# 배포 도메인(예: coldplace.apps.tossmini.com, coldplace.private-apps.tossmini.com)을 등록해야 해요.
VITE_KAKAO_MAP_KEY=

# Supabase 프로젝트 설정 (supabase.com > Project Settings > API)
# 비워두면 로컬(localStorage) 목 데이터로 동작해요 — 샌드박스 검증용.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
